<odoo>
  <data>
    <record id="mrp_bom_form_view_inherit_add_button" model="ir.ui.view">
      <field name="name">mrp.bom.form.inherit.add.button</field>
      <field name="model">mrp.bom</field>
      <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>  <!-- correct ref -->
      <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
          <button name="action_my_custom"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-globe">
            <div class="o_stat_info">
              <span class="o_stat_text">Update Stock</span>
            </div>
          </button>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
